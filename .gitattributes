# Normalize line endings: LF in repo, CRLF on Windows checkout
* text=auto eol=lf

# Force these to always be LF
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.cypher text eol=lf

# Binary files — do not modify
*.pt     binary
*.pth    binary
*.onnx   binary
*.png    binary
*.jpg    binary
